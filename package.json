{
  "name": "homebridge-jci-hitachi-platform",
  "displayName": "Homebridge Jci Hitachi Platform",
  "version": "1.6.0",
  "description": "Homebridge platform plugin providing HomeKit support for Jci Hitachi (Hitachi Taiwan) air conditioners on the AirCloud Home cloud.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tasict/homebridge-jci-hitachi-platform.git"
  },
  "bugs": {
    "url": "https://github.com/tasict/homebridge-jci-hitachi-platform/issues"
  },
  "homepage": "https://tasict.github.io/homebridge-jci-hitachi-platform/",
  "funding": [
    {
      "type": "individual",
      "url": "https://tasict.bobaboba.me"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/tasict"
    }
  ],
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0",
    "node": "^18.20.4 || ^20.15.1 || ^22.0.0 || ^24.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/test.*",
    "homebridge-ui",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "lint": "eslint src/**.ts --max-warnings=0",
    "build": "npm run clean && tsc",
    "build-watch": "npm run clean && tsc -w",
    "prepublishOnly": "npm run lint && npm run build",
    "postpublish": "npm run clean"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homebridge-jci-hitachi-platform",
    "homekit",
    "jci-hitachi",
    "ac",
    "hitachi",
    "hitachi tw",
    "air conditioner",
    "aircloud",
    "aircloud home",
    "supports-hap"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "aws-iot-device-sdk-v2": "^1.28.2",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "homebridge": "^2.4.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
